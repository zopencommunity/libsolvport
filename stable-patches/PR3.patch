+++ b/ext/solv_xfopen.c
@@ -32,6 +32,121 @@ static const char *binmode(const char *mode) {
 
 #ifndef WITHOUT_COOKIEOPEN
 
+#if !defined(HAVE_FUNOPEN) && !defined(HAVE_FOPENCOOKIE) && (defined(__MVS__) || !defined(_WIN32))
+#include <pthread.h>
+#include <unistd.h>
+#include <signal.h>
+#include <fcntl.h>
+#include <stdlib.h>	/* mkstemp */
+
+/*
+ * Pipe/worker fallback for platforms without fopencookie()/funopen()
+ * (e.g. z/OS). Read mode only; a detached worker thread streams decoded
+ * data from the cookie callbacks into a pipe that the caller reads as a
+ * regular FILE*.
+ *
+ * Known limitations (inherent to the pipe-based design, since a plain
+ * FILE* gives us no close/error hook):
+ *  - A codec read error ends the stream exactly like EOF, so the caller
+ *    sees short data rather than an ferror() failure.  Callers that parse
+ *    structured data (e.g. XML metadata) will still fail on truncation.
+ *  - fclose() on the returned FILE* does not wait for the worker; the
+ *    cookie close callback may run shortly after fclose() returns.
+ *  - Write/append modes are rejected upfront with ENOTSUP (see
+ *    solv_xfopen/solv_xfopen_fd) to avoid silently writing uncompressed
+ *    data or losing buffered output.
+ */
+struct solv_cookie_thread_arg {
+  int fd;                                         /* Worker's pipe write end */
+  void *cookie;                                   /* Codec cookie (gzFile, BZFILE*, etc.) */
+  ssize_t (*cread)(void *, char *, size_t);
+  ssize_t (*cwrite)(void *, const char *, size_t);
+  int (*cclose)(void *);
+};
+
+static void *solv_cookie_worker(void *data)
+{
+  struct solv_cookie_thread_arg *arg = (struct solv_cookie_thread_arg *)data;
+  sigset_t set;
+  char buf[32768];
+
+  /* Block SIGPIPE in worker thread */
+  sigemptyset(&set);
+  sigaddset(&set, SIGPIPE);
+  pthread_sigmask(SIG_BLOCK, &set, NULL);
+
+  for (;;)
+    {
+      errno = 0;
+      ssize_t n = arg->cread(arg->cookie, buf, sizeof(buf));
+      if (n < 0)
+        {
+          if (errno == EINTR)
+            continue;
+          break; /* Codec read error */
+        }
+      if (n == 0)
+        break; /* Clean EOF */
+
+      ssize_t off = 0;
+      while (off < n)
+        {
+          errno = 0;
+          ssize_t w = write(arg->fd, buf + off, n - off);
+          if (w < 0)
+            {
+              if (errno == EINTR)
+                continue;
+              goto out; /* Reader closed pipe early (e.g. EPIPE) or terminal error */
+            }
+          if (w == 0)
+            goto out;
+          off += w;
+        }
+    }
+
+out:
+  close(arg->fd);
+  if (arg->cclose)
+    arg->cclose(arg->cookie);
+  solv_free(arg);
+  return NULL;
+}
+
+/*
+ * Synchronous fallback for memory-backed streams (solv_fmemopen,
+ * solv_xfopen_buf read mode): copy the caller-owned buffer into an
+ * unlinked temp file and return a plain FILE* over it.  These must
+ * NOT use the pipe/worker fallback: a detached worker could call
+ * cookie_bufread() on caller-owned memory after the caller closed
+ * the stream and freed the buffer (use-after-free).
+ */
+static FILE *solv_memstream_open(const char *buf, size_t bufl)
+{
+  char template[] = "/tmp/solvmemXXXXXX";
+  int fd = mkstemp(template);
+  FILE *fp;
+  if (fd < 0)
+    return 0;
+  unlink(template);
+  /* "w+b" matches the O_RDWR descriptor mkstemp created; a plain "rb"
+     makes fwrite fail on strict fdopen implementations (z/OS). */
+  fp = fdopen(fd, "w+b");
+  if (!fp)
+    {
+      close(fd);
+      return 0;
+    }
+  if (bufl && buf && fwrite(buf, 1, bufl, fp) != bufl)
+    {
+      fclose(fp);
+      return 0;
+    }
+  rewind(fp);
+  return fp;
+}
+#endif
+
 FILE *solv_cookieopen(void *cookie, const char *mode,
 	ssize_t (*cread)(void *, char *, size_t),
 	ssize_t (*cwrite)(void *, const char *, size_t),
@@ -58,6 +173,69 @@ FILE *solv_cookieopen(void *cookie, const char *mode,
     cio.write = cwrite;
   cio.close = cclose;
   return  fopencookie(cookie, *mode == 'w' ? "w" : "r", cio);
+#elif defined(__MVS__) || !defined(_WIN32)
+  int pfd[2];
+  pthread_t thr;
+  pthread_attr_t attr;
+  struct solv_cookie_thread_arg *arg;
+  FILE *fp;
+
+  if (!cookie)
+    return 0;
+
+  if (*mode != 'r')
+    {
+      errno = ENOTSUP;
+      return 0; /* Keep cookie caller-owned on failure */
+    }
+
+  if (pipe(pfd) < 0)
+    return 0; /* Keep cookie caller-owned on failure */
+  /* Mark both ends close-on-exec: an inherited write end would keep the
+   * read end from seeing EOF after a fork+exec while decompression runs. */
+  fcntl(pfd[0], F_SETFD, FD_CLOEXEC);
+  fcntl(pfd[1], F_SETFD, FD_CLOEXEC);
+
+  fp = fdopen(pfd[0], "rb");
+  if (!fp)
+    {
+      close(pfd[0]);
+      close(pfd[1]);
+      return 0; /* Keep cookie caller-owned on failure */
+    }
+
+  arg = (struct solv_cookie_thread_arg *)solv_malloc(sizeof(*arg));
+  if (!arg)
+    {
+      fclose(fp);
+      close(pfd[1]);
+      return 0; /* Keep cookie caller-owned on failure */
+    }
+
+  arg->cookie = cookie;
+  arg->cread = cread;
+  arg->cwrite = cwrite;
+  arg->cclose = cclose;
+  arg->fd = pfd[1];
+
+  pthread_attr_init(&attr);
+  pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+
+#ifdef PTHREAD_STACK_MIN
+  pthread_attr_setstacksize(&attr, PTHREAD_STACK_MIN > 262144 ? PTHREAD_STACK_MIN : 262144);
+#endif
+
+  if (pthread_create(&thr, &attr, solv_cookie_worker, arg) != 0)
+    {
+      pthread_attr_destroy(&attr);
+      fclose(fp);
+      close(pfd[1]);
+      solv_free(arg);
+      return 0; /* Keep cookie caller-owned on failure */
+    }
+  pthread_attr_destroy(&attr);
+
+  return fp;
 #else
 # error Need to implement custom I/O
 #endif
