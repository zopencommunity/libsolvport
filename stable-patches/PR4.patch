diff --git a/test/runtestcases.sh b/test/runtestcases.sh
index 22b9166..f42f8ae 100755
--- a/test/runtestcases.sh
+++ b/test/runtestcases.sh
@@ -8,6 +8,12 @@ if test -z "$cmd" -o -z "$dir"; then
   exit 1
 fi
 
+for xml in $(find $dir -name \*.xml 2>/dev/null); do
+  test -f "$xml.gz" || gzip -c -9 "$xml" > "$xml.gz" 2>/dev/null || true
+  test -f "$xml.bz2" || bzip2 -c -9 "$xml" > "$xml.bz2" 2>/dev/null || true
+  test -f "$xml.zst" || zstd -c -19 "$xml" > "$xml.zst" 2>/dev/null || true
+done
+
 ex=0
 for tc in $(find $dir -name \*.t | sort) ; do
   $cmd $tc >/dev/null
