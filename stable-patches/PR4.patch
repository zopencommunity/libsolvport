diff --git a/test/runtestcases.sh b/test/runtestcases.sh
index 22b9166..a22b7ad 100755
--- a/test/runtestcases.sh
+++ b/test/runtestcases.sh
@@ -8,6 +8,18 @@ if test -z "$cmd" -o -z "$dir"; then
   exit 1
 fi
 
+for xml in $(find $dir -name \*.xml 2>/dev/null); do
+  if ! test -f "$xml.gz"; then
+    gzip -c -9 "$xml" > "$xml.gz.tmp" && mv "$xml.gz.tmp" "$xml.gz" || rm -f "$xml.gz.tmp"
+  fi
+  if ! test -f "$xml.bz2"; then
+    bzip2 -c -9 "$xml" > "$xml.bz2.tmp" && mv "$xml.bz2.tmp" "$xml.bz2" || rm -f "$xml.bz2.tmp"
+  fi
+  if ! test -f "$xml.zst"; then
+    zstd -c -19 "$xml" > "$xml.zst.tmp" 2>/dev/null && mv "$xml.zst.tmp" "$xml.zst" || rm -f "$xml.zst.tmp"
+  fi
+done
+
 ex=0
 for tc in $(find $dir -name \*.t | sort) ; do
   $cmd $tc >/dev/null
