 		}
+#ifdef ENABLE_RPMMD
+	      else if (!strcmp(repotype, "rpmmd") || !strcmp(repotype, "filelists"))
+		{
+		  int flags = is_extension ? (REPO_EXTEND_SOLVABLES | REPO_LOCALPOOL) : 0;
+		  int err = repo_add_rpmmd(repo, rfp, 0, flags);
+		  fclose(rfp);
+		  if (err)
+		    {
+		      pool_error(pool, 0, "testcase_read: repo_add_rpmmd failed for %s", rdata);
+		      missing_features = 1;
+		      continue;
+		    }
+		}
+	      else if (!strcmp(repotype, "updateinfo"))
+		{
+		  int err = repo_add_updateinfoxml(repo, rfp, 0);
+		  fclose(rfp);
+		  if (err)
+		    {
+		      pool_error(pool, 0, "testcase_read: repo_add_updateinfoxml failed for %s", rdata);
+		      missing_features = 1;
+		      continue;
+		    }
+		}
+	      else if (!strcmp(repotype, "deltainfo"))
+		{
+		  int err = repo_add_deltainfoxml(repo, rfp, 0);
+		  fclose(rfp);
+		  if (err)
+		    {
+		      pool_error(pool, 0, "testcase_read: repo_add_deltainfoxml failed for %s", rdata);
+		      missing_features = 1;
+		      continue;
+		    }
+		}
+#endif
+#ifdef ENABLE_COMPS
+	      else if (!strcmp(repotype, "comps"))
+		{
+		  int err = repo_add_comps(repo, rfp, 0);
+		  fclose(rfp);
+		  if (err)
+		    {
+		      pool_error(pool, 0, "testcase_read: repo_add_comps failed for %s", rdata);
+		      missing_features = 1;
+		      continue;
+		    }
+		}
+#endif
 #if ENABLE_TESTCASE_HELIXREPO
 	      else if (!strcmp(repotype, "helix"))
