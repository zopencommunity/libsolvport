diff --git a/test/runtestcases.sh b/test/runtestcases.sh
index 22b9166..58aa435 100755
--- a/test/runtestcases.sh
+++ b/test/runtestcases.sh
@@ -8,9 +8,29 @@ if test -z "$cmd" -o -z "$dir"; then
   exit 1
 fi
 
+# Generate compressed fixtures for the XML files referenced with a
+# compressed extension by the testcase files.  Generation is atomic
+# (tmp + mv) so a failing compressor cannot leave a cached empty or
+# corrupt fixture behind.  Only plain find/sed are used here as this
+# also has to work with the USS tools in restricted environments.
+for tc in $(find "$dir" -name '*.t'); do
+  sed -n 's/^repo [^ ]* [^ ]* [^ ]* \(.*\.xml\)\.\(gz\|bz2\|zst\)$/\1|\2/p' "$tc"
+done | sort -u \
+  | while IFS='|' read -r xml ext; do
+  xml="$dir/$xml"
+  test -f "$xml" || continue
+  z="$xml.$ext"
+  test -f "$z" && continue
+  case "$ext" in
+    gz)   gzip -c -9 "$xml" >"$z.tmp" && mv "$z.tmp" "$z" || rm -f "$z.tmp" ;;
+    bz2)  bzip2 -c -9 "$xml" >"$z.tmp" && mv "$z.tmp" "$z" || rm -f "$z.tmp" ;;
+    zst)  zstd -c -19 "$xml" >"$z.tmp" 2>/dev/null && mv "$z.tmp" "$z" || rm -f "$z.tmp" ;;
+  esac
+done
+
 ex=0
-for tc in $(find $dir -name \*.t | sort) ; do
-  $cmd $tc >/dev/null
+for tc in $(find "$dir" -name \*.t | sort) ; do
+  "$cmd" "$tc" >/dev/null
   tex=$?
   tcn="${tc#$dir/} .................................................."
   tcn="${tcn:0:50}"
